@model List<IntroduccionC_.Models.DistanciaEntreDosPuntos>

@{
    var resultado = "";

    if (Model.Count > 0)
    {
        resultado = Model.Last().Resultado.ToString();
    }
}

<div class="container">

    <div class="row">

        <div class="col-lg-6">

            <form action="/Distancia/Distancia" method="post">

                <label>X1:</label>
                <input type="text" name="X1" />

                <br />

                <label>Y1:</label>
                <input type="text" name="Y1" />

                <br />

                <label>X2:</label>
                <input type="text" name="X2" />

                <br />

                <label>Y2:</label>
                <input type="text" name="Y2" />

                <br />

                <input type="submit" value="Calcular" />

            </form>

        </div>

        <div class="col-lg-6">

            <br />

            <h1>La distancia es:</h1>

            <h2>@resultado</h2>

        </div>

    </div>

</div>